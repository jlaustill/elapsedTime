// Arduino AVR -- BlinkWithoutDelay, rewritten with elapsedTime.
//
// The canonical original keeps `previousMillis`, reads `millis()` into
// `currentMillis`, and open-codes the subtraction at the call site. Here the
// interval lives with the timer and `isDue` is the whole pattern.

#include <Arduino.h>
#include <ElapsedTime.cnx>

ElapsedTime.Timer blinkTimer <- { dueEvery: 1000, tick: millis };

bool ledOn <- false;

void setup() {
    pinMode(LED_BUILTIN, OUTPUT);
}

void loop() {
    bool due <- ElapsedTime.isDue(blinkTimer);
    if (due = true) {
        ledOn <- !ledOn;
        digitalWrite(LED_BUILTIN, ledOn);
    }
}
