// STM32 (Arduino core / STM32duino) -- BlinkWithoutDelay with elapsedTime.
#include <Arduino.h>
#include <ElapsedTime.cnx>

ElapsedTime.Timer blinkTimer <- { dueEvery: 1000, tick: millis };

bool ledOn <- false;

void setup() {
    pinMode(LED_BUILTIN, OUTPUT);
}

void loop() {
    bool due <- ElapsedTime.isDue(blinkTimer);
    if (due = true) {
        ledOn <- !ledOn;
        digitalWrite(LED_BUILTIN, ledOn);
    }
}
